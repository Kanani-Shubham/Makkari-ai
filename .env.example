# MAKKARI AI — Environment Variables Template

# 1. Supabase Credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# 2. Key Encryption (AES-256 WebCrypto)
ENCRYPTION_SECRET=makkari_secure_32_byte_secret_key_2026

# 3. AI Providers Configuration
NEXT_PUBLIC_OLLAMA_BASE_URL=http://localhost:11434
NEXT_PUBLIC_DEFAULT_PROVIDER=ollama

# 4. Application Info & Deployment URLs
NEXT_PUBLIC_APP_NAME=Makkari
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
PUBLISHABLE_KEY=sb_publishable_key
NODE_ENV=development
