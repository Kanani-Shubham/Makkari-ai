# ==============================================================================
# MAKKARI AI — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & DEPLOYMENT BASE URL (Single Source of Truth)
# ------------------------------------------------------------------------------
# Local Development: http://localhost:3000
# Production (Vercel): https://makkari-ai.vercel.app
NEXT_PUBLIC_APP_NAME=Makkari
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. SUPABASE CREDENTIALS (Authentication & Database)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Server-only (Never prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ------------------------------------------------------------------------------
# 3. KEY & MCP CREDENTIAL ENCRYPTION (AES-256-GCM WebCrypto)
# ------------------------------------------------------------------------------
# 32+ character secure cryptographic secret (Server-only)
ENCRYPTION_SECRET=makkari_secure_32_byte_secret_key_2026

# ------------------------------------------------------------------------------
# 4. CANVA MCP (Client ID Metadata Document — CIMD)
# ------------------------------------------------------------------------------
# Official Canva MCP Server endpoint
CANVA_MCP_URL=https://mcp.canva.com/mcp
# Note: Canva MCP uses CIMD (Client ID Metadata Document) by default:
# Client ID: <NEXT_PUBLIC_APP_URL>/.well-known/oauth-client-metadata.json
# Callback: <NEXT_PUBLIC_APP_URL>/api/mcp/canva/callback
# (Optional override if using explicit pre-registered client):
# CANVA_MCP_CLIENT_ID=
# CANVA_MCP_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 5. OLLAMA / LOCAL AI CONFIGURATION
# ------------------------------------------------------------------------------
# Local Development default: http://localhost:11434
# In Production (Vercel): Ollama is marked as Local-only unless a custom HTTPS
# remote tunnel/endpoint is explicitly configured below.
NEXT_PUBLIC_OLLAMA_BASE_URL=http://localhost:11434
NEXT_PUBLIC_DEFAULT_PROVIDER=ollama

# ------------------------------------------------------------------------------
# 6. OPTIONAL DEFAULT CLOUD PROVIDER KEYS (Users can also BYOK in Settings)
# ------------------------------------------------------------------------------
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
